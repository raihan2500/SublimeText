template<typename T = int>
struct ST{
  #define lc  node << 1
  #define rc  node << 1 | 1

  int n;
  vector<int> v;
  vector<T> t, lazy;
  ST(vector<int> v) : v(v){
    n = v.size() - 1;
    t.assign(4 * n, 0);
    lazy.assign(4 * n, 0);
    build(1, 1, n);
  }

  void build(int node, int lo, int hi){
    if(lo == hi){
      t[node] = v[lo];
      return;
    }
    int mid = (lo + hi) >> 1;
    build(lc, lo, mid);
    build(rc, mid + 1, hi);
    t[node] = pull(t[lc], t[rc]);
  }

  inline T pull(T a, T b){ //pull
    return a + b;
  }
  inline void push(int node, int lo, int hi){ //lazy
    if(lazy[node] == 0)return;
    
    int val = lazy[node]; 
    t[node] += (hi - lo + 1) * val;
    lazy[node] = 0;
    
    if(lo == hi)return;
    lazy[lc] = lazy[lc] + val;
    lazy[rc] = lazy[rc] + val;
  }


  void update(int node, int lo, int hi, int l, int r, int val){
    push(node, lo, hi);
    if(r < lo or l > hi)return;
    if(lo >= l and hi <= r){
      lazy[node] += val;    //update
      push(node, lo, hi);
      return;
    }
    int mid = (lo + hi) >> 1;
    update(lc, lo, mid, l, r, val);
    update(rc, mid + 1, hi, l, r, val);
    t[node] = pull(t[lc], t[rc]);
  }
  T query(int node, int lo, int hi, int l, int r){
    push(node, lo, hi);
    if(r < lo or l > hi)return 0;  //return
    if(lo >= l and hi <= r)return t[node];
    int mid = (lo + hi) >> 1;
    T q1 = query(lc, lo, mid, l, r);
    T q2 = query(rc, mid + 1, hi, l, r);
    return pull(q1, q2);
  }

  void update(int l, int r, int val){
    update(1, 1, n, l, r, val);
  }
  T query(int l, int r){
    return query(1, 1, n, l, r);
  }
};


