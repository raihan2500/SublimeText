using cd = complex<double>;
const double PI = acos(-1);

void fft(vector<cd> &p, bool invert) {
    int n = p.size();
    if (n == 1) return;
    vector<cd> pe(n / 2), po(n / 2);
    for (int i = 0; i < n / 2; i++) {
        pe[i] = p[2 * i];
        po[i] = p[2 * i + 1];
    }
    fft(pe, invert);
    fft(po, invert);

    double ang = 2 * PI / n * (invert ? -1 : 1);
    cd w(1), wd(cos(ang), sin(ang));

    for (int i = 0; i < n / 2; i++) {
        p[i] = pe[i] + w * po[i];
        p[i + n / 2] = pe[i] - w * po[i];
        if (invert) {
            p[i] /= 2;
            p[i + n / 2] /= 2;
        }
        w *= wd;
    }
}

struct BigInt {
    vector<int> a; // digits in base 10
    int sign;

    BigInt() : sign(1) {}
    BigInt(long long v) { *this = v; }
    BigInt(const string &s) { read(s); }

    BigInt& operator=(long long v) {
        sign = 1;
        if (v < 0) sign = -1, v = -v;
        a.clear();
        if (v == 0) a.push_back(0);
        while (v > 0) {
            a.push_back(v % 10);
            v /= 10;
        }
        return *this;
    }

    BigInt& normalize() {
        while (a.size() > 1 && a.back() == 0) a.pop_back();
        if (a.size() == 1 && a[0] == 0) sign = 1;
        return *this;
    }

    BigInt& read(const string &s) {
        sign = 1;
        a.clear();
        int pos = 0;
        if (s[0] == '-') sign = -1, pos++;
        for (int i = s.size() - 1; i >= pos; i--)
            a.push_back(s[i] - '0');
        normalize();
        return *this;
    }

    friend ostream& operator<<(ostream &out, const BigInt &v) {
        if (v.sign == -1) out << '-';
        for (int i = v.a.size() - 1; i >= 0; i--)
            out << v.a[i];
        return out;
    }

    // --- Compare absolute values ---
    static int cmpAbs(const BigInt &a, const BigInt &b) {
        if (a.a.size() != b.a.size())
            return a.a.size() < b.a.size() ? -1 : 1;
        for (int i = (int)a.a.size() - 1; i >= 0; i--)
            if (a.a[i] != b.a[i])
                return a.a[i] < b.a[i] ? -1 : 1;
        return 0;
    }

    // --- Addition ---
    friend BigInt operator+(BigInt a, const BigInt &b) {
        if (a.sign == b.sign) {
            int carry = 0;
            for (size_t i = 0; i < max(a.a.size(), b.a.size()) || carry; i++) {
                if (i == a.a.size()) a.a.push_back(0);
                a.a[i] += carry + (i < b.a.size() ? b.a[i] : 0);
                carry = a.a[i] >= 10;
                if (carry) a.a[i] -= 10;
            }
            return a;
        }
        return a - (-b);
    }

    // --- Negation ---
    BigInt operator-() const {
        BigInt res = *this;
        if (!(res.a.size() == 1 && res.a[0] == 0))
            res.sign = -sign;
        return res;
    }

    // --- Subtraction ---
    friend BigInt operator-(BigInt a, const BigInt &b) {
        if (b.a.size() == 1 && b.a[0] == 0) return a;
        if (a.sign == b.sign) {
            if (cmpAbs(a, b) < 0) return -(b - a);
            int carry = 0;
            for (size_t i = 0; i < b.a.size() || carry; i++) {
                a.a[i] -= carry + (i < b.a.size() ? b.a[i] : 0);
                carry = a.a[i] < 0;
                if (carry) a.a[i] += 10;
            }
            return a.normalize();
        }
        return a + (-b);
    }

    // --- Multiplication (FFT) ---
    friend BigInt operator*(const BigInt &x, const BigInt &y) {
        vector<cd> fa(x.a.begin(), x.a.end()), fb(y.a.begin(), y.a.end());
        int n = 1;
        while (n < (int)x.a.size() + (int)y.a.size()) n <<= 1;
        fa.resize(n); fb.resize(n);

        fft(fa, false);
        fft(fb, false);
        for (int i = 0; i < n; i++) fa[i] *= fb[i];
        fft(fa, true);

        vector<int> res(n);
        long long carry = 0;
        for (int i = 0; i < n; i++) {
            long long val = (long long)(round(fa[i].real())) + carry;
            res[i] = val % 10;
            carry = val / 10;
        }
        while (carry) {
            res.push_back(carry % 10);
            carry /= 10;
        }
        BigInt ans;
        ans.sign = x.sign * y.sign;
        ans.a = res;
        ans.normalize();
        return ans;
    }
};

