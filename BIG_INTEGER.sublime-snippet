using cd = complex<double>;
const double PI = acos(-1);
void fft(vector<cd> &p, bool inv) {
  int n = p.size();
  if (n == 1) return;
  vector<cd> a(n/2), b(n/2);
  for (int i=0; i<n/2; i++) a[i]=p[2*i], b[i]=p[2*i+1];
  fft(a, inv); fft(b, inv);
  cd w(1), wn(cos(2*PI/n*(inv?-1:1)), sin(2*PI/n*(inv?-1:1)));
  for (int i=0; i<n/2; i++) {
    p[i] = a[i] + w*b[i];
    p[i+n/2] = a[i] - w*b[i];
    if (inv) p[i]/=2, p[i+n/2]/=2;
    w *= wn;
  }
}

struct BigInt {
  vector<int> a; int sign=1;

  BigInt(){} 
  BigInt(long long v){ *this=v; }
  BigInt(const string &s){ read(s); }

  BigInt& operator=(long long v) {
    sign=1; if(v<0) sign=-1, v=-v;
    a.clear(); if(!v) a.push_back(0);
    while(v) a.push_back(v%10), v/=10;
    return *this;
  }

  BigInt& read(const string &s) {
    a.clear(); sign=1; int i=0;
    if(s[0]=='-') sign=-1, i++;
    for (int j=s.size()-1; j>=i; j--) a.push_back(s[j]-'0');
    return normalize();
  }

  BigInt& normalize() {
    while(a.size()>1 && a.back()==0) a.pop_back();
    if(a.size()==1 && a[0]==0) sign=1;
    return *this;
  }

  friend ostream& operator<<(ostream &out, const BigInt &v) {
    if(v.sign==-1) out << '-';
    for(int i=v.a.size()-1; i>=0; i--) out << v.a[i];
    return out;
  }

  static int cmpAbs(const BigInt &x, const BigInt &y) {
    if(x.a.size()!=y.a.size()) return x.a.size()<y.a.size()?-1:1;
    for(int i=x.a.size()-1;i>=0;i--) if(x.a[i]!=y.a[i]) return x.a[i]<y.a[i]?-1:1;
    return 0;
  }

  friend BigInt operator-(BigInt a){ 
    if(a.a.size()==1 && a.a[0]==0) return a;
    a.sign*=-1; return a; 
  }

  friend BigInt operator+(BigInt a, const BigInt &b) {
    if(a.sign==b.sign) {
      int c=0;
      for(size_t i=0;i<max(a.a.size(),b.a.size())||c;i++) {
        if(i==a.a.size()) a.a.push_back(0);
        a.a[i]+=c+(i<b.a.size()?b.a[i]:0);
        c=a.a[i]>=10; if(c) a.a[i]-=10;
      }
      return a;
    }
    return a-(-b);
  }

  friend BigInt operator-(BigInt a, const BigInt &b) {
    if(b.a.size()==1 && b.a[0]==0) return a;
    if(a.sign==b.sign) {
      if(cmpAbs(a,b)<0) return -(b-a);
      int c=0;
      for(size_t i=0;i<b.a.size()||c;i++) {
        a.a[i]-=c+(i<b.a.size()?b.a[i]:0);
        c=a.a[i]<0; if(c) a.a[i]+=10;
      }
      return a.normalize();
    }
    return a+(-b);
  }

  friend BigInt operator*(const BigInt &x, const BigInt &y) {
    vector<cd> fa(x.a.begin(), x.a.end()), fb(y.a.begin(), y.a.end());
    int n=1; while(n<(int)x.a.size()+(int)y.a.size()) n<<=1;
    fa.resize(n); fb.resize(n);
    fft(fa, 0); fft(fb, 0);
    for(int i=0;i<n;i++) fa[i]*=fb[i];
    fft(fa, 1);
    vector<int> res(n); long long c=0;
    for(int i=0;i<n;i++) {
      long long t=(long long)round(fa[i].real())+c;
      res[i]=t%10; c=t/10;
    }
    while(c) { res.push_back(c%10); c/=10; }
    BigInt ans; ans.a=res; ans.sign=x.sign*y.sign; return ans.normalize();
  }
};
