inline int Max(int a, int b){return max(a, b);}
inline int Min(int a, int b){return min(a, b);}

const int RET = 0;
inline int Pull(int a, int b){
  return a + b;
}

template<typename T = int, T(*pull)(T, T) = Pull, T R = RET>
struct ST{
  int n; 
  vector<T> v, t;
  ST(vector<T> v) : v(v){
    n = v.size() - 1; //1-based index
    t.resize(2 * n + 2);
    build();
  }

  void build(){
    for(int i = 1; i <= n; i++)t[i + n] = v[i];
    for(int i = n; i >= 1; i--){
      t[i] = pull(t[i << 1], t[i << 1 | 1]);
    } 
  }

  void update(int i, T val){
    i += n;  
    t[i] = val; //replace
    for(i >>= 1; i >= 1; i >>= 1){
      t[i] = pull(t[i << 1], t[i << 1 | 1]);
    }
  }
  T query(int l, int r){
    l += n; r += n;
    T ans = R;
    for(; l <= r; l >>= 1, r >>= 1){
      if(l % 2 == 1)ans = pull(ans, t[l++]);
      if(r % 2 == 0)ans = pull(ans, t[r--]);
    }
    return ans;
  }
};

