vector<int> nextGreater(vector<int> &v){
  int n = v.size();
  vector<int> ans(n, -1);
  stack<int> st;
  for(int i = 0; i < n; i++){
    while(!st.empty() and v[i] > v[st.top()]){
      ans[st.top()] = i;
      st.pop();
    }
    st.push(i);
  }
  return ans;
}

//Goal: For each day, find the number of consecutive previous days where the stock price was less than or equal to today’s price.
vector<int> stockSpan(vector<int> &v){
  int n = v.size();
  vector<int> ans(n);
  stack<int> st;
  for(int i = 0; i < n; i++){
    while(!st.empty() and v[i] >= v[st.top()]){
      st.pop();
    }
    ans[i] = (st.empty() ? (i + 1) : i - st.top());
    st.push(i);
  }
  return ans;
}

