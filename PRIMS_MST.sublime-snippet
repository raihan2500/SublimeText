void prims(){
  int n, m;
  cin >> n >> m;
  vector<pair<int, int>> graph[n + 1];
  for(int i = 0; i < m; i++){
    int x, y, w;
    cin >> x >> y >> w;
    graph[x].push_back({y, w});
    graph[y].push_back({x, w});
  }

  set<pair<int, int>> s;
  s.insert({0, 1});
  vector<bool> vis(n + 1);

  int ans = 0;
  while(!s.empty()){
    auto [w, u] = *s.begin();
    s.erase(s.begin());
    if(vis[u])continue;
    vis[u] = true;
    ans += w;

    for(auto &[v, w] : graph[u]){
      if(!vis[v])s.insert({w, v});
    }
  }
  
  cout << ans << endl;
}

