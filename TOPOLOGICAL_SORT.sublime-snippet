void topSort(){
  int n, m;
  cin >> n >> m;
  vector<int> graph[n + 1], indeg(n + 1);
  for(int i = 0; i < m; i++){
    int x, y;
    cin >> x >> y;
    indeg[y]++;
    graph[x].push_back(y);
  }

  queue<int> q;
  for(int i = 1; i <= n; i++){
    if(indeg[i] == 0)q.push(i);
  }

  while(!q.empty()){
    int u = q.front(); q.pop();
    cout << u << " ";
    for(auto &v : graph[u]){
      if(--indeg[v] == 0)q.push(v);
    }
  }
}

