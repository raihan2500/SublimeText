const int LG = 20;
int dep[N], par[N][LG + 1];
int mx[N][LG + 1], mn[N][LG + 1];

void init(int u = 1, int p = 0){ //take parameter mxi, mni for max min
  par[u][0] = p;
  // mx[u][0] = mxi;   mn[u][0] = mni;
  for(int i = 1; i <= LG; i++){
    par[u][i] = par[par[u][i - 1]][i - 1];
    // mx[u][i] = max(mx[u][i - 1], mx[par[u][i - 1]][i - 1]);
    // mn[u][i] = min(mn[u][i - 1], mn[par[u][i - 1]][i - 1]);
  }
  for(auto &v : graph[u])if(v != p){
    dep[v] = dep[u] + 1;
    init(v, u);
  }
}

int kth(int u, int k){
  if(k < 0)k = 0;
  while(k){
    int lg = log2(k);
    k -= (1 << lg);
    u = par[u][lg];
  }
  return u;
}

int lca(int u, int v){
  if(dep[u] < dep[v])swap(u, v);
  u = kth(u, dep[u] - dep[v]);
  if(u == v)return u;
  for(int i = LG; i >= 0; i--){
    if(par[u][i] == par[v][i])continue;
    u = par[u][i];
    v = par[v][i];
  }
  return par[u][0];
}

int dist(int u, int v){
  int lc = lca(u, v);
  return dep[u] + dep[v] - 2 * dep[lc];
}

//does x lies on path u->v?
bool onPath(int u, int v, int x){
  return (dist(u, x) + dist(v, x)) == dist(u, v);
}

//kth node from u-->v. 0th is u
int go(int u, int v, int k){
  int l = lca(u, v);
  int d = dep[u] + dep[v] - 2 * dep[l];
  assert(k <= d);
  if(dep[l] + k <= dep[u])return kth(u, k);
  k -= dep[u] - dep[l];
  return kth(v, dep[v] - dep[l] - k);
}
