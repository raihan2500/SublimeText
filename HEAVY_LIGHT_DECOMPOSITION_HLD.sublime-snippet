//Graph + LCA part
int n, m, q;
const int LG = 19;
vector<int> graph[N];
int par[N][LG + 1], sz[N], dep[N];

void init(int u, int p){
  sz[u] = 1;
  par[u][0] = p;
  for(int i = 1; i <= LG; i++)par[u][i] = par[par[u][i - 1]][i - 1];
  if(p)graph[u].erase(find(all(graph[u]), p));
  for(auto &v : graph[u])if(v != p){
    dep[v] = dep[u] + 1;
    init(v, u); 
    sz[u] += sz[v];
    auto &x = graph[u][0];
    if(sz[v] > sz[x])swap(v, x);
  } 
}
int kth(int u, int k){
  if(k < 0)k = 0;
  while(k){
    int lg = 31 - __builtin_clz(k); //log2(k)
    k -= (1 << lg);
    u = par[u][lg]; 
  }
  return u;
}
int lca(int u, int v){
  if(dep[u] < dep[v])swap(u, v);
  u = kth(u, dep[u] - dep[v]);
  if(u == v)return u;
  for(int i = LG; i >= 0; i--){
    if(par[u][i] == par[v][i])continue;
    u = par[u][i];
    v = par[v][i];
  }
  return par[u][0];
}


//HLD part
int cur_pos = 0;
vector<int> head(N), pos(N);

void hld(int u = 1){
  pos[u] = ++cur_pos;
  for(auto &v : graph[u]){
    if(v == graph[u][0])head[v] = head[u];
    else head[v] = v;
    hld(v);
  }
}

//Segment Tree
vector<int> arr, t(4 * N + 1);

const int R = 0;
inline int pull(int a, int b){
  return a + b;
}
#define lc node << 1
#define rc node << 1 | 1

void build(int node, int lo, int hi){
  if(lo == hi){
    t[node] = arr[lo];
    return;
  }
  int mid = (hi + lo) >> 1;
  build(lc, lo, mid);
  build(rc, mid + 1, hi);
  t[node] = pull(t[lc], t[rc]);
}
void update(int node, int lo, int hi, int l, int x){
  if(hi < l or lo > l)return;
  if(lo == hi){
    t[node] = arr[lo] = x;
    return;
  }
  int mid = (hi + lo) >> 1;
  update(lc, lo, mid, l, x);
  update(rc, mid + 1, hi, l, x);
  t[node] = pull(t[lc], t[rc]);
}
int query(int node, int lo, int hi, int l, int r){
  if(hi < l or lo > r)return R;
  if(lo >= l and hi <= r)return t[node];
  int mid = (hi + lo) >> 1;
  auto q1 = query(lc, lo, mid, l, r);
  auto q2 = query(rc, mid + 1, hi, l, r);
  return pull(q1, q2);
}
void Update(int l, int x){
  update(1, 1, n, l, x);
}
int Query(int l, int r){
  return query(1, 1, n, l, r);
}


//HLD query
int query_up(int u, int v){
  int ans = 0;
  while(head[u] != head[v]){
    int chain_head = head[u];
    int cur = Query(pos[chain_head], pos[u]);
    u = par[chain_head][0];
    ans = pull(ans, cur);
  }
  int cur = Query(pos[v], pos[u]);
  ans = pull(ans, cur);
  return ans;
}

int query(int u, int v){
  int l = lca(u, v);
  int ans = pull(query_up(u, l), query_up(v, l)) - query_up(l, l); //(-) for sum query
  return ans;
}

void reset(){
  cur_pos = 0;
  arr.assign(n + 1, 0);
  for(int i = 0; i <= n; i++){
    graph[i].clear();
    pos[i] = head[i] = 0;
    dep[i] = sz[i] = 0;
  }
}


void solve(){
  cin >> n;
  int vals[n + 1];
  for(int i = 1; i <= n; i++)cin >> vals[i];
  for(int i = 1; i < n; i++){
    int x, y;
    cin >> x >> y;
    graph[x].push_back(y);
    graph[y].push_back(x);
  }
  init(1, 0);
  head[1] = 1;
  hld(1);

  for(int i = 1; i <= n; i++)arr[pos[i]] = vals[i];
  build(1, 1, n);
  
  //enjoy here
  

}
