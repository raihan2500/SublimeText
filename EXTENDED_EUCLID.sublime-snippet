/*
  Extended Euclid Algorithm
  a*x + b*y = gcd(a, b) ............(1)
  
  b*x1 + (a%b)*y1 = gcd(a, b)
=>b*x1 + (a - [a - b]*b)*y1 = gcd(a, b)
=>b*x1 + a*y1 - [a/b]*b*y1 = gcd(a, b)
=>a*y1 + b(x1 - [a/b]*y1) = gcd(a, b) ......(2)

From (1) and (2)
=> x = y1
=> y = x1 - [a/b]*y1
*/

pii e_gcd(int a, int b){
  if(!b)return {1, 0};
  auto [x1, y1] = e_gcd(b, a%b);
  int x = y1;
  int y = x1 - (a / b)*y1;
  return {x, y};
}

int mmiofX(int a, int mod){
  return (mod + e_gcd(a, mod).first)%mod;
}
