template<int M = 1e9 + 7>
struct mint{
    int32_t x;
    inline mint(int xx = 0) : x(xx % M){}
    inline mint & operator = (int n){return x = n, *this;}
    inline mint & operator += (mint a){return (x += a.x) >= M && (x -= M), *this;}
    inline mint & operator -= (mint a){return (x -= a.x) < 0 && (x += M), *this;}
    inline mint & operator *= (mint a){return x = (uint64_t) x * a.x % M, *this;}
    inline mint & operator %= (mint a){return (x %= a.x), *this;}
    inline mint & operator ++(int32_t){return (*this += 1), *this;}
    inline mint & operator --(int32_t){return (*this -= 1), *this;}
    inline mint & operator ++(){return (*this += 1), *this;}
    inline mint & operator --(){return (*this -= 1), *this;}
    inline mint & operator ^= (int p){
        mint ans = 1, w = *this;
        for(; p; p >>= 1, w *= w)if(p & 1)ans *= w;
        return x = ans.x, *this;
    };

    inline mint & operator /= (mint a){return *this *= (a ^= (M - 2)); }
    friend inline mint operator + (mint a, mint b){return a += b;}
    friend inline mint operator - (mint a, mint b){return a -= b;}
    friend inline mint operator * (mint a, mint b){return a *= b;}
    friend inline mint operator / (mint a, mint b){return a /= b;}
    friend inline mint operator % (mint a, mint b){return a %= b;}
    friend inline mint operator ^ (mint a, mint b){return a ^= b.x;}
    friend inline mint operator ^ (mint a, int b){return a ^= b;}
    friend inline mint operator & (mint a, mint b){return a.x & b.x;}
    friend inline mint operator | (mint a, mint b){return a.x | b.x;}

    friend inline bool operator < (const mint &a, const mint &b){return a.x < b.x;}
    friend inline bool operator > (const mint &a, const mint &b){return a.x > b.x;}
    friend inline bool operator <= (const mint &a, const mint &b){return a.x <= b.x;}
    friend inline bool operator >= (const mint &a, const mint &b){return a.x >= b.x;}
    friend inline bool operator == (const mint &a, const mint &b){return a.x == b.x;}
    friend inline bool operator != (const mint &a, const mint &b){return a.x != b.x;}
    explicit operator bool() const { return x != 0; }


    friend std::ostream& operator<<(std::ostream& os, mint const& a) {return os << a.x;}
    friend std::istream& operator>>(std::istream &is, mint& a){
        int y; is >> y; (y %= M) < 0 && (y += M); 
        return a.x = y, is;        
    }
};


template<int MOD1 = 1000000007, int MOD2 = 998244353>
struct mint2 {
    mint<MOD1> f;
    mint<MOD2> s;
 
    mint2(int x = 0) : f(x), s(x) {}
    mint2(int x, int y):f(x), s(y){}
 
    inline mint2 & operator = (int x) { f = x; s = x; return *this; }
 
    inline mint2 & operator += (const mint2 &h) { f += h.f; s += h.s; return *this; }
    inline mint2 & operator -= (const mint2 &h) { f -= h.f; s -= h.s; return *this; }
    inline mint2 & operator *= (const mint2 &h) { f *= h.f; s *= h.s; return *this; }
    inline mint2 & operator /= (const mint2 &h) { f /= h.f; s /= h.s; return *this; }
 
    friend inline bool operator <  (const mint2 &a, const mint2 &b) { return a.f < b.f || (a.f == b.f && a.s < b.s); }
    friend inline bool operator <= (const mint2 &a, const mint2 &b) { return !(b < a); }
    friend inline bool operator >  (const mint2 &a, const mint2 &b) { return b < a; }
    friend inline bool operator >= (const mint2 &a, const mint2 &b) { return !(a < b); }
 
    inline mint2 & operator ^= (int p) { f ^= p; s ^= p; return *this; }
 
    friend inline mint2 operator + (mint2 a, const mint2 &b) { return a += b; }
    friend inline mint2 operator - (mint2 a, const mint2 &b) { return a -= b; }
    friend inline mint2 operator * (mint2 a, const mint2 &b) { return a *= b; }
    friend inline mint2 operator / (mint2 a, const mint2 &b) { return a /= b; }
    friend inline mint2 operator ^ (mint2 a, int b) { return a ^= b; }
 
    friend inline bool operator == (const mint2 &a, const mint2 &b) { return a.f == b.f && a.s == b.s; }
    friend inline bool operator != (const mint2 &a, const mint2 &b) { return !(a == b); }
 
    friend std::ostream& operator<<(std::ostream &os, const mint2 &h) { return os << "(" << h.f << "," << h.s << ")"; }
    friend std::istream& operator>>(std::istream &is, mint2 &h) { is >> h.f >> h.s; return is; }
 
};
