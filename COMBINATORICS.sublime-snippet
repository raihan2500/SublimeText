int binExp(int a, int b, int mod = M){
  int ans = 1; a %= mod;
  for(; b; b >>= 1, a = (__uint128_t) a * a % mod){
    if(b & 1)(ans = (__uint128_t) ans * a % mod);
  }
  return ans;
}
int bigMult(int a, int b, int mod = M){
  int ans = 0;
  for(; b; b >>= 1, a += a){
    if(b&1)ans += a;
  }
  return ans;
}
int mmiOfX(int b, int mod = M){ return binExp(b, mod - 2);}


int fact[N], inv[N];
void init(){
  fact[0] = inv[0] = 1;
  for(int i = 1; i < N; i++){
    fact[i] = fact[i - 1] * i % M;
  }
  inv[N - 1] = mmiOfX(fact[N - 1]);
  for(int i = N - 2; i >= 0; i--){
    inv[i] = inv[i + 1] * (i + 1) % M;
  }

  /*
    for(int n = 1; n <= 66; n++){
      nCr[n][0] = nCr[n][n] = 1;
      for(int r = 1; r < n; r++){
        nCr[n][r] = nCr[n - 1][r - 1] + nCr[n - 1][r];
      }
    }
  */
}
int nCr(int n, int r){return (__uint128_t) (fact[n] * inv[r] % M) * inv[n - r] % M; }
int nPr(int n, int r){return (__uint128_t) fact[n] * inv[n - r] % M; }
int catalan(int n){return nCr(2*n, n) * mmiOfX(n + 1) % M; }
int starsAndBars(int n, int k){return nCr(n + k - 1, k);}
