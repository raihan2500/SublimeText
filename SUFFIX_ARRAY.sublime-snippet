struct SuffixArray{
  int n;
  string str;
  vector<int> sa, rank;
  SuffixArray(){};
  SuffixArray(string str) : str(str){
    build(str);
  };

  int count(string pat){
    int m = pat.size();
    int lo = 0, hi = n - 2, lb;
    while(hi > lo){
      int mid = (hi + lo) >> 1;
      if(str.compare(sa[mid], m, pat) < 0)lo = mid + 1;
      else hi = mid;
    }
    if(str.compare(sa[lo], m, pat))return 0;
    
    lb = lo;  hi = n - 2;
    while(hi > lo){
      int mid = (hi + lo + 1) >> 1;
      if(str.compare(sa[mid], m, pat) <= 0)lo = mid;
      else hi = mid - 1;
    }
    return hi - lb + 1;
  }

  void counting_sort(vector<pair<pair<int,int>,int>> &v){
    int n = v.size();
    int mx = 0;
    for(int i = 0; i < n; i++)mx = max({mx, v[i].first.first, v[i].first.second});
    vector<pair<pair<int,int>,int>> ans(n);
    vector<int> cnt(mx + 1);
    for(int i = 0; i < n; i++)cnt[v[i].first.second]++;
    for(int i = 1; i <= mx; i++)cnt[i]+=cnt[i-1];
    for(int i = n - 1; i>=0; i--){
      ans[--cnt[v[i].first.second]] = v[i];
    }
    v = ans;
    fill(cnt.begin(), cnt.end(),0);

    for(int i = 0; i < n; i++)cnt[v[i].first.first]++;
    for(int i = 1; i <= mx; i++)cnt[i]+=cnt[i-1];
    for(int i = n - 1; i>=0; i--){
      ans[--cnt[v[i].first.first]] = v[i];
    }
    v = ans;
  }
  
  void build(string str){
    str.push_back('#');
    n = str.size();
    sa.assign(n, 0); rank.assign(n, 0);
    vector<pair<pair<int, int>, int>> v(n);
    
    for(int i = 0; i < n; i++)v[i] = {{str[i], 0}, i};
    counting_sort(v);
    for(int i = 0; i < n; i++)sa[i] = v[i].second;

    for(int i = 1; i < n; i++){
      if(v[i].first == v[i - 1].first){
        rank[sa[i]] = rank[sa[i - 1]];
      }else{
        rank[sa[i]] = rank[sa[i - 1]] + 1;
      }
    }

    for(int k = 0; (1 << k) < n; k++){
      for(int i = 0; i < n; i++){
        v[i] = {{rank[i], rank[(i + (1 << k)) % n]}, i};
      }
      counting_sort(v);
      for(int i = 0; i < n; i++)sa[i] = v[i].second;
      rank[sa[0]] = 0;
      for(int i = 1; i < n; i++){
        if(v[i].first == v[i - 1].first){
          rank[sa[i]] = rank[sa[i - 1]];
        }else{
          rank[sa[i]] = rank[sa[i - 1]] + 1;
        }
      }
    }
  }
};
