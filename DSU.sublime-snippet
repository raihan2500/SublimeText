struct Dsu{
  vector<int> par, sz;
  Dsu(int n = 10) : par(n + 1), sz(n + 1, 1){
    iota(par.begin(), par.end(), 0);
  }
  int Find(int u){
    return par[u] = (par[u] == u) ? u : Find(par[u]);
  }
  void Union(int u, int v){
    u = Find(u);
    v = Find(v);
    if(u == v)return;
    if(sz[u] < sz[v])swap(u, v);
    par[v] = u; sz[u] += sz[v];
  }
};

]]></content>
