vector<pii> edges;
int b_color[N];
bool bipar(int u, int c){
  if(b_color[u])return b_color[u] == c;
  b_color[u] = c;
  for(auto v : graph[u]){
    if(bipar(v, c == 1 ? 2 : 1) == false){
      return false;
    }
  }
  return true;
}

bool bipartite(){
  edges.clear();
  for(int i = 1; i <= n; i++)b_color[i] = 0;
  for(int i = 1; i <= n; i++){
    if(!b_color[i]){
      if(!bipar(i, 1))return false;
    }
  }
  for(int i = 1; i <= n; i++){
    for(auto j : graph[i]){
      if(b_color[i] == 1 and b_color[j] == 2){
        edges.push_back({i, j});
      }
    }
  }
  return true;
}
