template<typename T = int>
vector<vector<T>> transpose(vector<vector<T>> &v){
  int n = v.size(), m = v[0].size();
  vector<vector<T>> ans(m, vector<T>(n));
  for(int i = 0; i < n; i++){
    for(int j = 0; j < m; j++){
      ans[j][i] = v[i][j];
    }
  }
  return ans;
}

