int hp[N]; bool isPrime[N];
vector<int> primes, mu(N);

void sieve(){
  mu[1] = 1;
  for(int i = 2; i < N; i++){
    if(!hp[i]){
      hp[i] = i; isPrime[i] = 1;
      primes.push_back(i);
      mu[i] = -1;
    }
    for(auto &p : primes){
      if(p > hp[i] or i * p >= N)break;
      hp[i * p] = p;
      if(i%p == 0){
        mu[i*p] = 0; 
        break;
      }
      else mu[i*p] = -mu[i];
    }
  }
}
vector<int> factors(int n){
  vector<int> ans;
  while(n > 1){
    int p = hp[n];
    while(n % p == 0){
      ans.push_back(p);
      n /= p;
    }
  }
  return ans;
}
