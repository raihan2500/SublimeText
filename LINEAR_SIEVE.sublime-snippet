int hp[N]; bool isPrime[N];
vector<int> primes;

void sieve(){
  for(int i = 2; i < N; i++){
    if(!hp[i]){
      hp[i] = i; isPrime[i] = 1;
      primes.push_back(i);
    }
    for(auto &p : primes){
      if(p > hp[i] or i * p >= N)break;
      hp[i * p] = p;
    }
  }
}
vector<int> divisors(int n){
  vector<int> ans;
  while(n > 1){
    int p = hp[n];
    while(n % p == 0){
      ans.push_back(p);
      n /= p;
    }
  }
  return ans;
}
