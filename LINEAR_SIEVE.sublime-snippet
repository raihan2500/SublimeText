int spf[N]; bool isPrime[N];
vector<int> primes;

void sieve(){
  for(int i = 2; i < N; i++){
    if(!spf[i]){
      spf[i] = i; isPrime[i] = 1;
      primes.push_back(i);
    }
    for(auto &p : primes){
      if(p > spf[i] or i * p >= N)break;
      spf[i * p] = p;
    }
  }
}


