struct Trie{
  struct node{
    bool end = false;
    node* next[26] = {NULL};
  };
  node* root = new node();

  void insert(string str){
    int i = 0;
    node* it = root;
    while(i < str.size()){
      int c = str[i++] - 'a';
      if(it->next[c] == NULL)it->next[c] = new node();
      it = it->next[c];
    }
    it->end = true;
  }

  bool find(string str){
    int i = 0;
    node* it = root;
    while(i < str.size()){
      int c = str[i++] - 'a';
      if(it->next[c] == NULL)return false;
      it = it->next[c];
    }
    return it->end;
  }
};

