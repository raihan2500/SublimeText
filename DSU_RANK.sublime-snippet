struct Dsu{
  vector<int> par, rank, sz;
  Dsu(int n = 2e5): par(n + 1), rank(n + 1), sz(n + 1, 1){
    iota(par.begin(), par.end(), 0);
  }
  int Find(int v){
    return par[v] = (par[v] == v) ? v : Find(par[v]);
  }
  void Union(int a, int b){
    a = Find(a);
    b = Find(b);
    if(a == b)return;
    if(rank[a] < rank[b])swap(a, b);
    if(rank[a] == rank[b])rank[a]++;
    par[b] = a;  sz[a] += sz[b];
  }
};


