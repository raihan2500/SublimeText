struct Arti{
  int n, k = 0;
  vector<vector<int>> g,t;
  vector<bool> vis;
  vector<int> comp, ord, low;
  struct edge{int x, y;};
  vector<edge> cut;
  
  Arti(vector<vector<int>> &g) : g(g), n(g.size()){
    vis.resize(n + 1);
    ord.resize(n + 1); 
    low = comp = ord;
    int c = 1;
    for(int i = 1; i <= n; i++){
      if(vis[i])continue;
      dfs(i, 0, c);
      dfs2(i, ++k);
    }
  } 
  
  void dfs(int u, int p, int &c){
    vis[u] = 1; ord[u] = low[u] = c++;
    bool mul = 0;
    for(auto &v : g[u]){
      if(vis[v]){
        if(v != p or mul)low[u] = min(low[u], ord[v]);
        else mul = 1;
      }else{
        dfs(v, u, c);
        low[u] = min(low[u], low[v]);
      }
    }
  }

  void dfs2(int u, int num){
    comp[u] = num;
    for(auto &v : g[u]){
      if(comp[v])continue;
      if(ord[u] < low[v]){
        cut.push_back({u, v});
        dfs2(v, ++k);
      }else{
        dfs2(v, num);
      }
    }
  }

  void build_tree(){
    t.resize(k + 1);
    for(auto e : cut){
      int x = comp[e.x], y = comp[e.y];
      t[x].push_back(y);
      t[y].push_back(x); 
    }
  }
};

